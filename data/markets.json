   "pay": "Cash or 30 days for small buyers; contracts for big ones."
  },
  "retail": {
   "n": "Supermarkets (own brand)",
   "nature": "Chains that sell your product under their own name (private label). Few buyers, large orders.",
   "cares": "Price, packaging, shelf life, steady supply. Charge fees for shelf space and promotions.",
   "pay": "Often 60–90 days."
  },
  "foodservice": {
   "n": "Restaurants & caterers",
   "nature": "Restaurant chains, hotels, caterers and airline kitchens. Buy through distributors in buckets and bulk packs.",
   "cares": "Taste, consistency, easy-to-use packs.",
   "pay": "Usually 30–60 days via distributors."
  },
  "importer": {
   "n": "Importers & wholesalers",
   "nature": "Trading companies that buy containers and resell to smaller shops and factories in their country.",
   "cares": "Price per container, documents, payment terms.",
   "pay": "Letter of credit or cash against documents."
  },
  "processor": {
   "n": "Ingredient processors",
   "nature": "Companies that process further and resell to big brands (e.g. gum and sesame processors). Also competitors.",
   "cares": "Raw-material grade, traceability, volume.",
   "pay": "Contracts; letter of credit."
  },
  "drinks": {
   "n": "Drink makers & flavour houses",
   "nature": "Soft-drink bottlers, juice and concentrate makers, and the flavour companies that supply them.",
   "cares": "Exact technical specification, food-additive approval, Halal/Kosher, audits.",
   "pay": "Contracts after a long approval (6–18 months)."
  },
  "tea": {
   "n": "Tea & herbal packers",
   "nature": "Companies that blend and pack herbal teas, often for many brands.",
